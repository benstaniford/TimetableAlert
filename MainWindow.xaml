<Window x:Class="TimetableAlert.MainWindow"
        x:ClassModifier="internal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:tb="clr-namespace:H.NotifyIcon;assembly=H.NotifyIcon.Wpf"
        Title="Timetable Alert" Height="0" Width="0"
        ShowInTaskbar="False"
        WindowStyle="None"
        ResizeMode="NoResize"
        Opacity="0">
    <Grid>
        <tb:TaskbarIcon
            x:Name="TrayIcon"
            IconSource="/icons/app.ico"
            ToolTipText="Timetable Alert"
            Visibility="Visible"
            TrayLeftMouseUp="TrayIcon_LeftClick">
            <tb:TaskbarIcon.ContextMenu>
                <ContextMenu>
                    <MenuItem Header="_Load timetable…" Click="LoadTimetable_Click"/>
                    <MenuItem Header="_Reload timetable" Click="ReloadTimetable_Click"/>
                    <Separator/>
                    <MenuItem Header="Refresh from _calendar" Click="RefreshFromCalendar_Click"/>
                    <MenuItem Header="Timetable _source…" Click="TimetableSource_Click"/>
                    <Separator/>
                    <MenuItem Header="_Today's lessons" Click="TodaysLessons_Click"/>
                    <MenuItem Header="Test _overlay" Click="TestOverlay_Click"/>
                    <Separator/>
                    <MenuItem Header="_View logs" Click="ViewLogs_Click"/>
                    <MenuItem Header="_About" Click="About_Click"/>
                    <MenuItem Header="E_xit" Click="Exit_Click"/>
                </ContextMenu>
            </tb:TaskbarIcon.ContextMenu>
        </tb:TaskbarIcon>
    </Grid>
</Window>
