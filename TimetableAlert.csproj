<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationIcon>icons\app.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- CA1303: this is a single-user, English-only app; UI strings are literals by design. -->
    <NoWarn>$(NoWarn);NETSDK1233;CA1303</NoWarn>
    <DefaultItemExcludes>$(DefaultItemExcludes);TimetableAlert.Tests\**;TimetableAlert.Core\**;TimetableAlert.Installer\**</DefaultItemExcludes>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="H.NotifyIcon.Wpf" Version="2.1.4" />
  </ItemGroup>

  <!-- WinForms is referenced only for Screen.AllScreens; drop its implicit usings so that
       Application, MessageBox and friends unambiguously mean the WPF ones. -->
  <ItemGroup>
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="TimetableAlert.Core\TimetableAlert.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="icons\app.ico" />
    <None Update="icons\app.ico" CopyToOutputDirectory="PreserveNewest" />
    <None Update="timetable.sample.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
